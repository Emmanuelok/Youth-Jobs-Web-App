# Postgres connection (Vercel Postgres / Neon).
# Vercel auto-injects this when you attach a Postgres store to the project.
# For local dev: copy this file to `.env.local` and paste a Neon dev URL.
DATABASE_URL=postgres://user:password@host/db?sslmode=require

# 32+ character random string used to encrypt session cookies.
# Generate one with:  openssl rand -base64 48
SESSION_SECRET=replace-with-a-strong-random-string-of-at-least-32-chars

# SMS provider for OTP delivery.
# `stub` (default) prints the OTP to the server console — fine for dev.
# Switch to `arkesel` or `hubtel` once their integrations are wired in.
SMS_PROVIDER=stub
# ARKESEL_API_KEY=
# HUBTEL_CLIENT_ID=
# HUBTEL_CLIENT_SECRET=

# Comma-separated list of phone numbers (E.164) that auto-receive admin role
# on first sign-in. Keep this short and trusted.
ADMIN_PHONES=
