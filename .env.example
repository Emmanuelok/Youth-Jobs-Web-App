# Postgres connection (Vercel Postgres / Neon).
# Vercel auto-injects this when you attach a Postgres store to the project.
# For local dev: copy this file to `.env.local` and paste a Neon dev URL.
DATABASE_URL=postgres://user:password@host/db?sslmode=require

# 32+ character random string used to encrypt session cookies.
# Generate one with:  openssl rand -base64 48
SESSION_SECRET=replace-with-a-strong-random-string-of-at-least-32-chars

# SMS provider for OTP delivery.
# `stub` (default) prints the OTP to the server console — fine for dev.
# `arkesel` requires ARKESEL_API_KEY and ARKESEL_SENDER_ID (≤11 alphanumeric
#   chars, registered with Arkesel before it will deliver).
# `hubtel` is wired but not yet implemented.
SMS_PROVIDER=stub
# ARKESEL_API_KEY=
# ARKESEL_SENDER_ID=GhYouthJobs
# HUBTEL_CLIENT_ID=
# HUBTEL_CLIENT_SECRET=

# WhatsApp provider for application updates and job alert digests.
# Stubbed by default. Real providers (360dialog, twilio, meta) need a Meta
# Business approval, a registered phone number, and message templates.
WHATSAPP_PROVIDER=stub
# WHATSAPP_API_KEY=

# Anthropic API key for the AI CV generator.
# Get one at https://console.anthropic.com — never commit it.
# Without this set, the /cv page renders a friendly "AI not configured" notice.
# ANTHROPIC_API_KEY=

# Comma-separated list of phone numbers (E.164) that auto-receive admin role
# on first sign-in. Keep this short and trusted.
ADMIN_PHONES=

# Secret used to authenticate Vercel Cron callbacks. Generate with:
#   openssl rand -hex 32
# Set the SAME value in Vercel → Project → Settings → Environment Variables.
# Vercel will then automatically send `Authorization: Bearer ${CRON_SECRET}`
# to /api/cron/* on the schedule defined in vercel.json.
CRON_SECRET=

# Public-facing app URL. Used in SMS/WhatsApp digests so links resolve.
# In Vercel this is auto-derived from VERCEL_PROJECT_PRODUCTION_URL when
# unset, but setting it explicitly avoids surprises across preview deploys.
# Example: https://ghanayouthjobs.app
NEXT_PUBLIC_APP_URL=

# Upstash Redis credentials for rate limiting. Free tier covers MVP.
# Without these, rate limiting is DISABLED — fine for local dev but every
# abuse-prone surface (apply, message, post, report) is uncapped.
# Create a database at https://console.upstash.com — copy the REST URL + token.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Sentry DSN for server-side error tracking. Without this, errors land
# only in Vercel function logs. Strongly recommended for production.
SENTRY_DSN=
